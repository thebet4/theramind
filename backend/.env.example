# TheraMind - Environment Variables Example
# Copy this file to .env and fill with your credentials

# Application
NODE_ENV=development
APP_NAME=TheraMind
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database (Supabase PostgreSQL)
DATABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# AWS S3
S3_BUCKET_NAME=
S3_BUCKET_REGION=

# AWS SQS
SQS_QUEUE_URL=
DQL_QUEUE_URL=
DQL_QUEUE_ARN=


# AWS Lambda
LAMBDA_FUNCTION_NAME=

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Redis (Upstash for rate limiting)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

# Security
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Feature Flags
ENABLE_MFA=
ENABLE_AUDIO_VALIDATION=
MAX_AUDIO_DURATION_MINUTES=
MAX_AUDIO_SIZE_MB=

# Email (for notifications, optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Development Only
DEBUG=
LOG_LEVEL=

