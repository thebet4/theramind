{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "S3AudioUploads",
        "Effect": "Allow",
        "Action": [
          "s3:PutObject",
          "s3:GetObject",
          "s3:DeleteObject",
          "s3:HeadObject"
        ],
        "Resource": "arn:aws:s3:::theramind-audio-uploads/audio-uploads/*"
      },
      {
        "Sid": "S3ListBucket",
        "Effect": "Allow",
        "Action": [
          "s3:ListBucket"
        ],
        "Resource": "arn:aws:s3:::theramind-audio-uploads",
        "Condition": {
          "StringLike": {
            "s3:prefix": "audio-uploads/*"
          }
        }
      },
      {
        "Sid": "SQSSendMessages",
        "Effect": "Allow",
        "Action": [
          "sqs:SendMessage",
          "sqs:GetQueueUrl",
          "sqs:GetQueueAttributes"
        ],
        "Resource": "arn:aws:sqs:us-east-1:*:theramind-*"
      }
    ]
}